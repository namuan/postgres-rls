# Export these in your shell (or set them in your environment) before
# ./run.sh — the API server reads them at startup. run.sh does not load a
# .env file. The container itself is configured by run.sh — these variables
# are only for the Rust API process (and the teacher-mode endpoint).

# Connection for the real application pool (least-privilege role)
DATABASE_URL=host=127.0.0.1 port=54329 user=app_user password=app_user_demo_password dbname=rls_demo

# Superuser connection, used ONLY by the demo-only /demo/truth teacher endpoint
AUDITOR_DATABASE_URL=host=127.0.0.1 port=54329 user=postgres password=postgres_demo_password dbname=rls_demo

# Listen address for the API + WebUI
BIND=127.0.0.1:8081
