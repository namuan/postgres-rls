# --- macOS ---
.DS_Store

# --- Logs ---
*.log

# --- Rust (api/) ---
# Build output
**/target/
# Runtime pidfile written by run.sh / stop.sh (regenerated on every run)
api/*.pid
# Cargo.lock is intentionally committed: this is a binary crate, not a library.

# --- Environment / secrets ---
# Local overrides for DATABASE_URL / AUDITOR_DATABASE_URL / BIND
# (see api/env.example — never commit real credentials)
.env
.env.*

# --- Editors / IDEs ---
.idea/
.vscode/
*.iml

